# Copy to .env and replace every change_me value:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# --- Postgres (source OLTP "shop" DB) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=shop
POSTGRES_PORT=5432

# --- SeaweedFS S3 gateway (data lake) ---
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=change_me_s3_access
S3_SECRET_KEY=change_me_s3_secret
S3_BUCKET=lake
S3_REGION=us-east-1
S3_PORT=8333

# --- ClickHouse (warehouse) ---
CLICKHOUSE_USER=warehouse
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_DB=analytics
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Kafka ---
KAFKA_PORT=9094
KAFKA_BOOTSTRAP=127.0.0.1:9094
KAFKA_TOPIC_EVENTS=clickstream.events

# --- Metabase ---
METABASE_PORT=3000
