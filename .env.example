# Copy to .env and replace every change_me value:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# --- Postgres (source OLTP "shop" DB) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=shop
POSTGRES_PORT=5432

# --- SeaweedFS S3 gateway (data lake) ---
S3_ENDPOINT=http://localhost:8333
# Endpoint as seen from inside the compose network (ClickHouse's s3() reads this).
S3_ENDPOINT_INTERNAL=http://seaweedfs:8333
S3_ACCESS_KEY=change_me_s3_access
S3_SECRET_KEY=change_me_s3_secret
S3_BUCKET=lake
S3_REGION=us-east-1
S3_PORT=8333

# --- ClickHouse (warehouse) ---
CLICKHOUSE_HOST=127.0.0.1
# Hostname as seen from inside the compose network (Metabase connects this way).
CLICKHOUSE_HOST_INTERNAL=clickhouse
CLICKHOUSE_USER=warehouse
CLICKHOUSE_PASSWORD=change_me_clickhouse
# Read-only user Metabase connects as (created by metabase/provision.py).
CLICKHOUSE_RO_USER=metabase
CLICKHOUSE_RO_PASSWORD=change_me_clickhouse_ro
CLICKHOUSE_DB=analytics
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Kafka ---
KAFKA_PORT=9094
KAFKA_BOOTSTRAP=127.0.0.1:9094
KAFKA_TOPIC_EVENTS=clickstream.events

# --- Metabase ---
METABASE_PORT=3000
# Used by metabase/provision.py to complete first-run setup and create the
# ClickHouse connection + dashboards reproducibly.
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me_metabase
METABASE_ADMIN_FIRST_NAME=Shop
METABASE_ADMIN_LAST_NAME=Stream

# --- Airflow (orchestration) ---
AIRFLOW_PORT=8080
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change_me_airflow_fernet_key
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
